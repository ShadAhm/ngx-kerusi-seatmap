/* Workspace-wide TypeScript options, shared by every package.
   Framework-specific compiler options live in tsconfig.angular.json and in
   each package's own tsconfig — nothing here may assume a framework. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "paths": {
      "@kerusiweb/core": ["./projects/core/src/public-api.ts"],
      "@kerusiweb/angular": ["./projects/angular/src/public-api.ts"],
      "@kerusiweb/react": ["./projects/react/src/public-api.ts"],
      "@kerusi/demo-scenarios": ["./projects/demo-scenarios/src/index.ts"],
      "@kerusi/demo-scenarios/*": ["./projects/demo-scenarios/src/*"]
    },
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "files": [],
  "references": [
    {
      "path": "./projects/core/tsconfig.json"
    },
    {
      "path": "./projects/react/tsconfig.json"
    },
    {
      "path": "./projects/angular/tsconfig.lib.json"
    },
    {
      "path": "./projects/angular/tsconfig.spec.json"
    },
    {
      "path": "./projects/angular-demo/tsconfig.app.json"
    },
    {
      "path": "./projects/angular-demo/tsconfig.spec.json"
    }
  ]
}
