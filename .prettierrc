{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "comment": "Angular template syntax only parses under the angular parser; plain HTML elsewhere (the React demo's index.html) must not go through it.",
      "files": ["projects/angular/**/*.html", "projects/angular-demo/**/*.html"],
      "options": {
        "parser": "angular"
      }
    }
  ]
}
