{
  "name": "ngx-kerusi-seatmap-ws",
  "version": "0.0.0",
  "workspaces": [
    "projects/core",
    "projects/ngx-kerusi-seatmap"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "ng build",
    "build:core": "tsc -p projects/core/tsconfig.json",
    "build:lib": "npm run build:core && ng build ngx-kerusi-seatmap",
    "build:demo": "ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:core": "vitest run --root projects/core",
    "test:lib": "ng test ngx-kerusi-seatmap --watch=false",
    "test:demo": "ng test demo --watch=false",
    "test:ci": "npm run test:core && npm run test:lib && npm run test:demo"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
