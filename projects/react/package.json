    "svg",
    "booking",
    "ticketing",
    "cinema",
    "airline",
    "venue"
  ],
  "license": "MIT",
  "author": "Arshad Ahmad",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadAhm/kerusiweb.git",
    "directory": "projects/react"
  },
  "homepage": "https://github.com/ShadAhm/kerusiweb",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
