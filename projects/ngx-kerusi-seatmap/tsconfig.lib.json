/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    /* Resolve @kerusiweb/core through node_modules (the workspace symlink to
       projects/core/dist) rather than the root source alias, so ng-packagr
       keeps it external instead of compiling core into this bundle.
       Run `npm run build:core` first. */
    "paths": {},
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
